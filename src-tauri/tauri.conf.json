{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kütral",
  "version": "26.9.2",
  "identifier": "app.kutral",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kütral",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "decorations": false,
        "backgroundColor": "#0a0608"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http:",
        "frame-src": "https:",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "resources": ["vendor/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RTJDNDcxOTQ0NTNDMUYKUldRZlBFV1VjY1RpS2VmTDNJZm1LVXRQY0NYakF4WTRZRUVCMGxGeHlETWhwU1NxaCt2MG92YngK",
      "endpoints": [
        "https://github.com/Debaq/kutral/releases/latest/download/latest.json"
      ]
    }
  }
}
